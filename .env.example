# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# NE JAMAIS mettre .env dans un dépôt public (git).

# Trouvés sur la page "General settings" de ta console Twilio :
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=ton_auth_token_ici

# Le numéro Twilio qui envoie le SMS (acheté sur Twilio, format +33...)
TWILIO_FROM_NUMBER=+33600000000

# Optionnel : nom affiché comme expéditeur au lieu du numéro (11 caractères max,
# lettres/chiffres uniquement, pas d'espaces spéciaux). Non disponible partout
# (interdit aux USA/Canada). Si vide, TWILIO_FROM_NUMBER sera utilisé.
TWILIO_SENDER_ID=MonSite

# Le numéro fixe qui recevra toujours le SMS (format international +33...)
DESTINATION_NUMBER=+33600000000

# Port du serveur (optionnel)
PORT=3000
