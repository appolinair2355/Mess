# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# NE JAMAIS mettre .env dans un dépôt public (git).

# Trouvés sur ton compte prosms.pro > "Mon API"
PROSMS_API_KEY=ta_cle_api_ici
PROSMS_API_PASS=ton_mot_de_passe_api_ici

# Nom affiché comme expéditeur (11 caractères max, lettres/chiffres uniquement)
PROSMS_SENDER_ID=MonSite

# Le numéro fixe qui recevra toujours le SMS (format international +225...)
DESTINATION_NUMBER=+2250700000000

# Port du serveur (optionnel)
PORT=3000
